{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "cross-env nodemon --watch src --ext ts --exec ts-node -r dotenv/config src/server.ts",
    "build": "tsc",
    "start": "cross-env NODE_ENV=production node -r dotenv/config dist/server.js",
    "start:pm2": "NODE_ENV=production pm2 start dist/server.js --name mass-mailer-backend",
    "monitor:campaign": "ts-node scripts/monitor-campaign.ts",
    "reconcile:campaign-status": "ts-node scripts/reconcile-campaign-status.ts",
    "test:s3": "ts-node scripts/test-s3.ts",
    "test:aws": "ts-node scripts/test-aws.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "reset:domain-usage": "ts-node scripts/reset-domain-usage.ts",
    "requeue:campaign": "ts-node -r dotenv/config src/scripts/requeue-failed-campaign.ts",
    "cleanup:redis-quotas": "ts-node -r dotenv/config src/scripts/cleanup-redis-quotas.ts",
    "reset:relay-health": "ts-node src/scripts/reset-relay-health.ts",
    "cleanup:old-recipients": "ts-node -r dotenv/config src/scripts/cleanup-old-recipients.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1014.0",
    "@aws-sdk/client-ses": "^3.1014.0",
    "@aws-sdk/client-sts": "^3.1030.0",
    "@aws-sdk/s3-request-presigner": "^3.1014.0",
    "@bull-board/api": "^8.1.0",
    "@bull-board/express": "^8.1.0",
    "@logtail/winston": "^0.5.8",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.71.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.3.1",
    "morgan": "^1.10.1",
    "nodemailer": "^8.0.3",
    "uuid": "^13.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^7.0.11",
    "@types/uuid": "^10.0.0",
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
