#!/bin/sh
echo "🔨 Running npm run build before push..."
cd "$(git rev-parse --show-toplevel)" || exit 1
npm run build
if [ $? -ne 0 ]; then
  echo "❌ Build failed. Push aborted."
  exit 1
fi
echo "✅ Build succeeded. Staging and committing dist/..."
git add dist/
if ! git diff --cached --quiet; then
  git commit --amend --no-edit --no-verify
  echo "✅ dist/ committed (amended). Proceeding with push."
else
  echo "✅ dist/ unchanged. Proceeding with push."
fi
